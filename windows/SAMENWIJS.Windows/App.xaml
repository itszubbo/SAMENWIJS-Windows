<Application x:Class="SAMENWIJS.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="PageBrush" Color="#F5F3ED" />
        <SolidColorBrush x:Key="InkBrush" Color="#20312D" />
        <SolidColorBrush x:Key="BrandBrush" Color="#286457" />
        <SolidColorBrush x:Key="MutedBrush" Color="#4D5D57" />
    </Application.Resources>
</Application>
