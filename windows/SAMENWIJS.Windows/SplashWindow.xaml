<Window x:Class="SAMENWIJS.Windows.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SAMENWIJS" Width="500" Height="355"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen" AllowsTransparency="True" Background="Transparent">
    <Border Background="#F5F3ED" BorderBrush="#C9D7CF" BorderThickness="1" CornerRadius="22" Padding="28">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Image Grid.Row="0" Source="Assets/samenwijs.png" Width="104" Height="104" HorizontalAlignment="Center" Margin="0,4,0,12" />
            <TextBlock Grid.Row="1" Text="SAMENWIJS" FontSize="30" FontWeight="Bold" Foreground="#20312D" HorizontalAlignment="Center" />
            <TextBlock Grid.Row="2" Text="Duidelijk wat komt. Ruimte om zelf te kiezen." FontSize="16" Foreground="#4D5D57" HorizontalAlignment="Center" Margin="0,6,0,0" />
            <StackPanel Grid.Row="4" Margin="0,22,0,0">
                <ProgressBar IsIndeterminate="True" Height="7" Foreground="#286457" Background="#DCE7E0" BorderThickness="0" />
                <TextBlock Text="Een momentje, SAMENWIJS start op…" FontSize="14" Foreground="#4D5D57" HorizontalAlignment="Center" Margin="0,12,0,0" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
